{
  "info": {
    "name": "Compound Intelligence API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Screening runs, compounds, and analysis jobs for the compound intelligence platform."
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get('access_token')) {",
          "    pm.sendRequest({",
          "        url: pm.environment.get('base_url') + '/api/v1/auth/token',",
          "        method: 'POST',",
          "        header: { 'Content-Type': 'application/json' },",
          "        body: { mode: 'raw', raw: JSON.stringify({ api_key: pm.environment.get('api_key') }) }",
          "    }, function (err, res) {",
          "        if (!err && res.code === 200) {",
          "            pm.environment.set('access_token', res.json().access_token);",
          "        }",
          "    });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Compounds",
      "item": [
        {
          "name": "Create Compound",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/compounds",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Aspirin\",\n  \"molecular_formula\": \"C9H8O4\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Response has Location header', () => pm.response.to.have.header('Location'));",
                  "pm.test('Response has ETag header', () => pm.response.to.have.header('ETag'));",
                  "const body = pm.response.json();",
                  "pm.environment.set('compound_id', body.compound_id);",
                  "pm.environment.set('compound_etag', pm.response.headers.get('ETag'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Compound (conditional)",
          "request": {
            "method": "GET",
            "header": [{ "key": "If-None-Match", "value": "{{compound_etag}}" }],
            "url": "{{base_url}}/api/v1/compounds/{{compound_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 or 304', () => [200, 304].includes(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Rename Compound (optimistic concurrency)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "If-Match", "value": "{{compound_etag}}" }
            ],
            "url": "{{base_url}}/api/v1/compounds/{{compound_id}}",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Acetylsalicylic Acid\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.environment.set('compound_etag', pm.response.headers.get('ETag'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Rename Compound - stale ETag (expect 409)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "If-Match", "value": "\"stale-etag-value\"" }
            ],
            "url": "{{base_url}}/api/v1/compounds/{{compound_id}}",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Should Fail\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status is 409', () => pm.response.to.have.status(409));"]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Screening Runs",
      "item": [
        {
          "name": "Submit Screening Run",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/v1/screening-runs",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"compound_id\": \"{{compound_id}}\",\n  \"assay_type\": \"binding\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.environment.set('run_id', pm.response.json().run_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List Screening Runs (paginated)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/compounds/{{compound_id}}/screening-runs?limit=20&offset=0",
              "query": [
                { "key": "limit", "value": "20" },
                { "key": "offset", "value": "0" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response has meta.count', () => pm.response.json().meta.count !== undefined);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Screening Run - not found (expect error contract)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/screening-runs/00000000-0000-0000-0000-000000000000"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404', () => pm.response.to.have.status(404));",
                  "pm.test('Error contract has code and request_id', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.error.code).to.eql('SCREENING_RUN_NOT_FOUND');",
                  "    pm.expect(body.error.request_id).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
